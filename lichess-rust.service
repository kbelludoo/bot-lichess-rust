[Unit]
Description=Lichess Autonomous Chess Bot (Native Rust Zero-GC Engine)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bots-rust/bot-lichess-rust
ExecStart=/home/ubuntu/bots-rust/bot-lichess-rust/bot-lichess-rust
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
Environment=RUST_LOG=info
Environment=PORT=3016
Environment=STOCKFISH_PATH=/usr/games/stockfish

[Install]
WantedBy=multi-user.target
